{
  "name": "@2heal1/tvis",
  "version": "0.0.0",
  "description": "A localhost review desk for long Codex and Trae CLI replies.",
  "type": "module",
  "files": [
    "bin",
    "public",
    "server.mjs",
    "README.md"
  ],
  "bin": {
    "tvis": "./bin/tvis.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "tvis": "node bin/tvis.mjs",
    "check": "node --check server.mjs && node --check public/app.js && node --check bin/tvis.mjs",
    "publish:bootstrap": "./scripts/bootstrap-npm-release.sh",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2heal1/t-vis.git"
  },
  "bugs": {
    "url": "https://github.com/2heal1/t-vis/issues"
  },
  "homepage": "https://github.com/2heal1/t-vis#readme",
  "keywords": [
    "codex",
    "trae",
    "cli",
    "review"
  ],
  "license": "MIT"
}
